# Generate a local access token with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
RESEARCH_API_KEY=
DATABASE_URL=sqlite:///./work/research.db
ALLOWED_ORIGINS=http://localhost:5173
# All three must be set for live inference. Choose a model with multilingual JSON support.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_RETRIES=2
# Opt in only for Groq. Shared pacing is local to one backend provider instance.
PROVIDER_GROQ_PACING=false
PROVIDER_CALL_DEADLINE_SECONDS=300
# Example Groq Free 30 RPM: allow a small margin over 2 seconds/request.
GROQ_MIN_REQUEST_INTERVAL_SECONDS=2.1
GROQ_MISSING_HEADERS_WAIT_SECONDS=60
GROQ_MAX_WAIT_SECONDS=120
# Longer full-pipeline runs (4 candidates, up to 2 triggered refinements).
MAX_RUN_SECONDS=1800
# Local development only. Use migrations and false in deployment.
INITIALIZE_DATABASE=true
