                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Analysis": {
        "properties": {
          "detected_language": {
            "type": "string",
            "enum": [
              "english",
              "hindi",
              "malayalam",
              "hinglish",
              "minglish",
              "ambiguous"
            ],
            "title": "Detected Language"
          },
          "detected_script": {
            "type": "string",
            "enum": [
              "latin",
              "devanagari",
              "malayalam",
              "mixed",
              "unknown"
            ],
            "title": "Detected Script"
          },
          "suggested_output_language": {
            "$ref": "#/components/schemas/Language"
          },
          "target": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Target"
          },
          "emotion": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Emotion"
          },
          "hostility": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Hostility"
          },
          "language_uncertainty": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Language Uncertainty"
          },
          "context_summary": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Context Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detected_language",
          "detected_script",
          "suggested_output_language",
          "target",
          "emotion",
          "hostility",
          "language_uncertainty",
          "context_summary"
        ],
        "title": "Analysis"
      },
      "Assessment": {
        "properties": {
          "safe": {
            "type": "boolean",
            "title": "Safe"
          },
          "toxicity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Toxicity"
          },
          "relevance": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Relevance"
          },
          "argument_strength": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Argument Strength"
          },
          "language_quality": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Language Quality"
          },
          "language_matches": {
            "type": "boolean",
            "title": "Language Matches"
          },
          "decision_summary": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Decision Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "safe",
          "toxicity",
          "relevance",
          "argument_strength",
          "language_quality",
          "language_matches",
          "decision_summary"
        ],
        "title": "Assessment"
      },
      "Candidate": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Id"
          },
          "round_index": {
            "type": "integer",
            "title": "Round Index"
          },
          "strategy": {
            "$ref": "#/components/schemas/Strategy"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "simulation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Simulation"
              },
              {
                "type": "null"
              }
            ]
          },
          "assessment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Assessment"
              },
              {
                "type": "null"
              }
            ]
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "eligible": {
            "type": "boolean",
            "title": "Eligible",
            "default": false
          },
          "decision_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Decision Reasons"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidate_id",
          "round_index",
          "strategy",
          "text"
        ],
        "title": "Candidate"
      },
      "ConversationCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "title": "Title",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ConversationCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Language": {
        "type": "string",
        "enum": [
          "english",
          "hindi",
          "malayalam",
          "hinglish",
          "minglish"
        ],
        "title": "Language"
      },
      "Mode": {
        "type": "string",
        "enum": [
          "full",
          "no_history",
          "no_simulation",
          "single_shot"
        ],
        "title": "Mode"
      },
      "ObservedTurn": {
        "properties": {
          "speaker": {
            "type": "string",
            "enum": [
              "original_speaker",
              "human_reply"
            ],
            "title": "Speaker"
          },
          "text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text"
          },
          "provenance": {
            "type": "string",
            "const": "user_provided_observation",
            "title": "Provenance",
            "default": "user_provided_observation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "speaker",
          "text"
        ],
        "title": "ObservedTurn"
      },
      "ReactionProbabilities": {
        "properties": {
          "deescalate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Deescalate"
          },
          "neutral": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Neutral"
          },
          "escalate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Escalate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "deescalate",
          "neutral",
          "escalate"
        ],
        "title": "ReactionProbabilities"
      },
      "Round": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "ranking": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Ranking"
          },
          "refinement_feedback": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Refinement Feedback"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index",
          "candidates"
        ],
        "title": "Round"
      },
      "RunRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "initial_context": {
            "items": {
              "$ref": "#/components/schemas/ObservedTurn"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Initial Context"
          },
          "output_language": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Language"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_script": {
            "$ref": "#/components/schemas/Script",
            "default": "auto"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode",
            "default": "full"
          },
          "candidate_count": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 2.0,
            "title": "Candidate Count",
            "default": 3
          },
          "max_refinements": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Max Refinements",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "RunRequest"
      },
      "RunResult": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Analysis"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_language": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Language"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_script": {
            "$ref": "#/components/schemas/Script"
          },
          "rounds": {
            "items": {
              "$ref": "#/components/schemas/Round"
            },
            "type": "array",
            "title": "Rounds"
          },
          "selected": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Candidate"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "completed",
              "abstained"
            ],
            "title": "Outcome"
          },
          "disclosure": {
            "type": "string",
            "title": "Disclosure",
            "default": "Simulated reactions and assessment scores are uncalibrated model estimates, not observed human behavior or independently validated evaluation. Human review required."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode",
          "analysis",
          "output_language",
          "output_script",
          "rounds",
          "selected",
          "outcome"
        ],
        "title": "RunResult"
      },
      "RunView": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "abstained",
              "failed"
            ],
            "title": "Status"
          },
          "request": {
            "additionalProperties": true,
            "type": "object",
            "title": "Request"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/TraceEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "conversation_id",
          "status",
          "request",
          "result",
          "error_code",
          "events",
          "created_at",
          "updated_at"
        ],
        "title": "RunView"
      },
      "Script": {
        "type": "string",
        "enum": [
          "auto",
          "native",
          "romanized"
        ],
        "title": "Script"
      },
      "Simulation": {
        "properties": {
          "reaction_class": {
            "type": "string",
            "enum": [
              "deescalate",
              "neutral",
              "escalate"
            ],
            "title": "Reaction Class"
          },
          "probabilities": {
            "$ref": "#/components/schemas/ReactionProbabilities"
          },
          "simulated_reply": {
            "type": "string",
            "maxLength": 2000,
            "title": "Simulated Reply"
          },
          "decision_summary": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Decision Summary"
          },
          "uncertainty": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Uncertainty"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reaction_class",
          "probabilities",
          "simulated_reply",
          "decision_summary",
          "uncertainty"
        ],
        "title": "Simulation"
      },
      "Strategy": {
        "type": "string",
        "enum": [
          "empathy",
          "factual_correction",
          "shared_values",
          "reflective_question",
          "direct_response"
        ],
        "title": "Strategy"
      },
      "TraceEvent": {
        "properties": {
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sequence",
          "stage",
          "payload",
          "created_at"
        ],
        "title": "TraceEvent"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
