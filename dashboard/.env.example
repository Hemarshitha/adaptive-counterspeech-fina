# SERVER ONLY: copy to dashboard/.env; never use a VITE_ prefix for secrets.
# Same RESEARCH_API_KEY as the backend's ignored root .env.
RESEARCH_API_KEY=
DASHBOARD_BACKEND_URL=http://127.0.0.1:8000
DASHBOARD_PORT=5173
# Longer than backend MAX_RUN_SECONDS, in milliseconds (default 600 seconds).
DASHBOARD_TIMEOUT_MS=660000
# Optional: exact 32-character ID from chrome://extensions (or edge://extensions).
# Restart the dashboard to print a single-use 5-minute extension pairing code.
DASHBOARD_EXTENSION_ID=
