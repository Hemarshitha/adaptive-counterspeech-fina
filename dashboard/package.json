{
  "name": "counterspeech-research-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format:check": "prettier --check src server tests/*.ts *.json *.ts",
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs --production",
    "test": "vitest run && node --test server/*.test.mjs",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "extension:build": "node ../extension/build.mjs",
    "extension:test": "node --test ../extension/tests/*.test.mjs",
    "test:extension": "playwright test --config playwright.extension.config.ts",
    "extension:format": "prettier --check ../extension/*.{js,mjs,json,html,css} ../extension/tests/*.{ts,mjs}"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.8"
  }
}
